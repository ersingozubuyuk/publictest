# Kopyalayın:  cp .env.example .env   ve değerleri düzenleyin.
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=degistir-beni
DASHBOARD_PORT=8080
# SUSE verisinin kaç saatte bir kontrol edileceği (0 = kapalı)
REFRESH_HOURS=24
